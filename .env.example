# Every variable is optional. Copy to .env.local and fill only what you use.
# Never commit the filled file.

# Private Robinhood Chain RPC (e.g. Alchemy). Empty = public RPC.
ROBINHOOD_RPC_URL=
NEXT_PUBLIC_ROBINHOOD_RPC_URL=

# WalletConnect project id (cloud.reown.com). Empty = WalletConnect shows "Not configured".
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Redis the agent keeper writes its log to (rounds, playbook, spend). Empty = sample data.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# or a redis:// URL
KV_REDIS_URL=
# Key prefix (default "connex:")
CHAT_KEY_PREFIX=

# Self-hosted behind a proxy only
TRUST_PROXY_HEADERS=
TRUSTED_PROXY_HOPS=
CLIENT_IP_HEADER=
